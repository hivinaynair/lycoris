{
  "name": "@settle-kit/agents",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "build": "bun ../../../scripts/build-settle-kit.mjs agents",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@settle-kit/core": "workspace:*",
    "@x402/core": "^2.17.0",
    "@x402/fetch": "^2.17.0",
    "viem": "^2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "^5"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "description": "x402 paid fetch and AP2 mandate helpers for agents.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hivinaynair/lycoris.git",
    "directory": "packages/settle-kit/agents"
  },
  "bugs": {
    "url": "https://github.com/hivinaynair/lycoris/issues"
  }
}
