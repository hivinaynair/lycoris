{
  "name": "@settle-kit/react",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./ui": {
      "types": "./dist/ui.d.ts",
      "bun": "./src/ui.ts",
      "default": "./dist/ui.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "build": "bun ../../../scripts/build-settle-kit.mjs react",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "dependencies": {
    "@settle-kit/core": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.2.2",
    "react": "^19.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "description": "React hooks and an optional checkout UI for Settle Kit.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hivinaynair/lycoris.git",
    "directory": "packages/settle-kit/react"
  },
  "bugs": {
    "url": "https://github.com/hivinaynair/lycoris/issues"
  }
}
