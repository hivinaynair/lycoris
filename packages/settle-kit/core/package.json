{
  "name": "@settle-kit/core",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./account-abstraction": {
      "types": "./dist/methods/user-op-receipt.d.ts",
      "bun": "./src/methods/user-op-receipt.ts",
      "default": "./dist/methods/user-op-receipt.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "build": "bun ../../../scripts/build-settle-kit.mjs core",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "viem": "^2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "^5",
    "viem": "^2"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "description": "Headless USDC checkout sessions with balance preflight and receipt confirmation.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hivinaynair/lycoris.git",
    "directory": "packages/settle-kit/core"
  },
  "bugs": {
    "url": "https://github.com/hivinaynair/lycoris/issues"
  }
}
