{
  "name": "lycoris",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=lycoris... --filter=facilitator... --filter=agent...",
    "dev:ui": "turbo run dev --filter=lycoris...",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "test": "bun test",
    "check-boundaries": "bun scripts/check/boundaries.mjs && bun scripts/check/settle-kit.mjs",
    "check-tokens": "bun scripts/check/tokens.mjs",
    "ui:add": "turbo run add --filter=@repo/ui",
    "db:push": "turbo run db:push --filter=@repo/db",
    "preinstall": "[ -n \"$CI$VERCEL\" ] || bunx only-allow@1.2.2 bun",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@happy-dom/global-registrator": "^20.11.2",
    "@repo/mocks": "*",
    "@repo/typescript-config": "*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "dependency-cruiser": "^17.3.10",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/settle-kit/*",
    "e2e/*",
    "tooling/*"
  ],
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.51.2",
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "solc": "^0.8.35",
    "viem": "^2.54.3"
  }
}
