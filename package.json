{
  "name": "lycoris",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=lycoris --filter=facilitator --filter=agent",
    "dev:ui": "turbo run dev --filter=lycoris",
    "dev:facilitator": "turbo run dev --filter=facilitator",
    "dev:agent": "turbo run dev --filter=agent",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "test": "bun test",
    "e2e": "turbo run e2e",
    "check-boundaries": "bun scripts/check-boundaries.mjs && bun scripts/check-settle-kit.mjs",
    "check-tokens": "bun scripts/check-tokens.mjs",
    "ui:add": "turbo run add --filter=@repo/ui",
    "db:push": "turbo run db:push --filter=@repo/db",
    "lycoris:compile-contracts": "bun packages/scripts/compile-contracts.ts",
    "lycoris:deploy-contracts": "bun --env-file=packages/scripts/.env.local packages/scripts/deploy-contracts.ts",
    "lycoris:fund-wallet": "bun --env-file=packages/scripts/.env.local packages/scripts/fund-wallet.ts",
    "lycoris:bootstrap": "bun --env-file=packages/scripts/.env.local packages/scripts/demo-bootstrap/index.ts",
    "preinstall": "bunx only-allow@1.2.2 bun",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@happy-dom/global-registrator": "^20.11.2",
    "@repo/mocks": "*",
    "@repo/typescript-config": "*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "dependency-cruiser": "^17.3.10",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/settle-kit/*",
    "e2e/*",
    "tooling/*"
  ],
  "dependencies": {}
}
