{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/scripts/build-settle-kit.mjs"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "SKIP_ENV_VALIDATION",
        "AGENT_URL",
        "APP_URL",
        "ATTESTATION_REGISTRY_ADDRESS",
        "BOOTSTRAP_SECRET",
        "CDP_API_KEY_ID",
        "CDP_API_KEY_SECRET",
        "CDP_PAYMASTER_URL",
        "CDP_WALLET_SECRET",
        "DATABASE_URL",
        "EXTERNAL_X402_URL",
        "FACILITATOR_PRIVATE_KEY",
        "FACILITATOR_URL",
        "LYCORIS_AGENT_SHARED_SECRET",
        "MANDATES_JSON",
        "MANDATE_FILE",
        "PAY_TO_ADDRESS",
        "SPONSORED_WALLET_ADDRESS"
      ],
      "passThroughEnv": ["CI", "VERCEL", "VERCEL_ENV", "VERCEL_URL", "VERCEL_REGION"]
    },
    "//#format-and-lint": {
      "description": "Check for formatting and linting issues"
    },
    "//#format-and-lint:fix": {
      "cache": false,
      "description": "Format and lint the code and fix the issues"
    },
    "check-types": {
      "dependsOn": [
        "^check-types",
        "@settle-kit/core#build",
        "@settle-kit/react#build",
        "@settle-kit/agents#build",
        "@settle-kit/server#build",
        "@settle-kit/mcp#build"
      ],
      "passThroughEnv": ["SKIP_ENV_VALIDATION"]
    },
    "db:generate": {
      "cache": false,
      "envMode": "loose"
    },
    "db:migrate": {
      "cache": false,
      "envMode": "loose",
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "db:push": {
      "cache": false,
      "envMode": "loose",
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "envMode": "loose",
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "//#check-boundaries": {
      "description": "Enforce Next.js feature folder boundaries in apps/*"
    },
    "e2e": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["PLAYWRIGHT_*", "CI", "PORT"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "add": {
      "cache": false
    }
  }
}
